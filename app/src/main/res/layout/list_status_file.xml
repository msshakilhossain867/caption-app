<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/primary"
    android:layout_margin="@dimen/_8sdp"
    android:id="@+id/back_round"
    android:layout_height="wrap_content">


    <LinearLayout
        android:id="@+id/saveFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/userProfile"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_10sdp"
            android:src="@drawable/love"
            app:civ_border_color="#fff"
            app:civ_border_width="@dimen/_4sdp" />


        <TextView
            android:id="@+id/statusId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"

            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_8sdp"

            android:gravity="center"
            android:text="আমি খুশি কারণ তুই আমার বোন/দিদি আমার পৈচাশিক আনন্দ হয়কারণ তুই এই বিষয় নিয়ে কিছুই করতে পারবিনা"
            android:textColor="@color/txt_color"
            android:textSize="@dimen/_18ssp"

            />

        <TextView
            android:id="@+id/useName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginEnd="@dimen/_25sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:text="TypeuseName"
            android:shadowColor="#201F1F"
            android:shadowDx="5"
            android:shadowDy="5"
            android:shadowRadius="10"
            android:textColor="@color/txt_color"
            android:textSize="@dimen/_14ssp"
            android:textStyle="italic" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_linear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/saveFile"
        android:layout_marginBottom="@dimen/_4sdp"
        android:orientation="horizontal"
        android:background="#fff">

      <LinearLayout
          android:id="@+id/copyId"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center"
          android:padding="@dimen/_5sdp"
          android:orientation="vertical">
          <ImageView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:src="@drawable/round_content_copy_24"
              android:layout_weight="1"
              app:tint="@color/drawable_tint" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="Copy"
              android:textColor="@color/editor_text_color"
              android:textSize="@dimen/_11ssp"
              />


      </LinearLayout>
        <LinearLayout
            android:id="@+id/shareId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:orientation="vertical">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_share_24"
                android:layout_weight="1"
                app:tint="@color/drawable_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="share"
                android:textColor="@color/editor_text_color"
                android:textSize="@dimen/_11ssp"
                />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/downloadId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:orientation="vertical">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_download_24"
                android:layout_weight="1"
                app:tint="@color/drawable_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="download"
                android:textColor="@color/editor_text_color"
                android:textSize="@dimen/_11ssp"
                />


        </LinearLayout>
        <LinearLayout
            android:id="@+id/editId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:orientation="vertical">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_text_fields_24"
                android:layout_weight="1"
                app:tint="@color/drawable_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit"
                android:textColor="@color/editor_text_color"
                android:textSize="@dimen/_11ssp"
                />


        </LinearLayout>






    </LinearLayout>



</RelativeLayout>