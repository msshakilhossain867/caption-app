<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/_16sdp"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_50sdp"
            android:scaleType="centerCrop"
            android:src="@drawable/baseline_downloading_24"
            android:layout_marginRight="@dimen/_10sdp"
            app:tint="@color/dialog_color_2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Download Image without watermark by watch a ads..!"
            android:textSize="@dimen/_20ssp"
            android:textColor="@color/dialog_color_2"
           />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/_16sdp"
        android:gravity="right"
        >
        <TextView
            android:id="@+id/withoutWaterMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Download Without WaterMark"
            android:textSize="@dimen/_16ssp"
            android:textColor="@color/dashboard_item_3"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/withWaterMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Download With WaterMark"
            android:layout_marginTop="@dimen/_20sdp"
            android:textColor="@color/dashboard_item_1"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/exitId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exit.."
            android:textSize="@dimen/_16ssp"
            android:textColor="@color/exit_color"
            android:layout_marginTop="@dimen/_16sdp"
            android:textStyle="bold"/>


    </LinearLayout>






</LinearLayout>