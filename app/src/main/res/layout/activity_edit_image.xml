<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="4dp"
    tools:context=".Edit_image">

    <RelativeLayout
        android:id="@+id/bgRelativeSize"
        android:layout_marginBottom="12dp"
        android:layout_width="match_parent"
        android:background="@drawable/bg_4"
        android:layout_above="@+id/downLayout"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/bgSet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/status_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>


        <RelativeLayout
            android:id="@+id/waterMarkId"
            android:layout_width="wrap_content"

            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"


            >
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/watherMarkIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/ic_launcher"
                app:civ_border_color="#FFFFFF"
                app:civ_border_width="4dp"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="20dp"

                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/watherMarkIcon"
                android:layout_alignParentRight="true"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/wather_mark_text_bg"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:padding="3dp"
                android:text="@string/app_name"
                android:textColor="#000"
                android:textSize="9.5sp"
                android:textStyle="bold" />



        </RelativeLayout>

        <View android:id="@+id/nextImage"
            android:layout_width="match_parent"
            android:visibility="visible"
            android:layout_height="match_parent"
            android:background="@drawable/image_shadow"
            />


        <RelativeLayout
            android:id="@+id/statusDropDown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_margin="10dp"
            android:background="@drawable/image_shadow_2"
            android:orientation="vertical">


            <RelativeLayout
                android:id="@+id/proId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"

                >

                <de.hdodenhof.circleimageview.CircleImageView

                    android:id="@+id/profileChangeId"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/splsh"
                    app:civ_border_color="#FFFFFF"
                    app:civ_border_width="4dp" />


                <TextView
                    android:id="@+id/profileNameId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@+id/profileChangeId"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="TypeYoureName"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_17ssp"
                    android:textStyle="bold" />


            </RelativeLayout>

            <TextView

                android:id="@+id/editText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/proId"
                android:layout_marginStart="20dp"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/italic_normal"
                android:gravity="center"

                android:shadowColor="@color/text_shadow"
                android:shadowDx="5"
                android:shadowDy="5"
                android:shadowRadius="10"
                android:text="এত মোটা মানূসকে ভাল রাখা সম্ভব না আগে নিজের ওজন কমান"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="normal" />





        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/logoDropDown"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            >

            <View
                android:id="@+id/view3"
                android:layout_width="50dp"
                android:layout_centerVertical="true"
                android:layout_height="2dp"
                android:layout_marginStart="8dp"
                android:background="#fff"/>

            <LinearLayout
                android:id="@+id/layIcon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_toEndOf="@id/view3"
                android:gravity="center"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="8dp"
                >


                <de.hdodenhof.circleimageview.CircleImageView
                    app:civ_border_width="4dp"
                    android:src="@drawable/fb_icon"
                    app:civ_border_color="#FFFFFF"
                    android:layout_width="30dp"
                    android:layout_height="30dp"/>

                <de.hdodenhof.circleimageview.CircleImageView
                    app:civ_border_width="4dp"
                    android:src="@drawable/insta_icon"
                    app:civ_border_color="#FFFFFF"
                    android:layout_width="30dp"
                    android:layout_marginStart="3dp"
                    android:layout_height="30dp"/>

                <de.hdodenhof.circleimageview.CircleImageView
                    app:civ_border_width="4dp"
                    android:src="@drawable/yt_icon"
                    app:civ_border_color="#FFFFFF"

                    android:layout_width="30dp"
                    android:layout_marginStart="3dp"
                    android:layout_height="30dp"/>

                <de.hdodenhof.circleimageview.CircleImageView
                    app:civ_border_width="4dp"
                    android:src="@drawable/tik_icon"
                    app:civ_border_color="#FFFFFF"
                    android:layout_width="30dp"
                    android:layout_marginStart="3dp"
                    android:layout_height="30dp"/>


            </LinearLayout>

            <View
                android:id="@+id/view4"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#fff"
                android:layout_toEndOf="@id/layIcon"
                android:layout_marginBottom="10dp"
                />

            <TextView
                android:id="@+id/socialAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/view4"
                android:text="SocialAppName"
                android:textColor="#fff"
                android:textStyle="bold|italic"
                android:textSize="14sp" />


        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/waterMarkId2"
        android:layout_width="@dimen/_80sdp"
        android:layout_alignParentRight="true"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"


        >
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/watherMarkIcon2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_launcher"
            app:civ_border_color="#FFFFFF"
            app:civ_border_width="4dp"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="20dp"

            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/watherMarkIcon2"
            android:layout_alignParentRight="true"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/wather_mark_text_bg"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:padding="3dp"
            android:text="@string/app_name"
            android:textColor="#000"
            android:textSize="9.5sp"
            android:textStyle="bold" />



    </RelativeLayout>




    <LinearLayout
        android:id="@+id/downLayout"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/white"

        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        >
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/download_image"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp"
                    app:cardElevation="8dp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        >

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Download"
                            android:textSize="30sp"
                            android:textStyle="bold"/>


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/editTExtForDesgin"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    app:cardElevation="8dp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/_8sdp"
                        android:gravity="center"
                        >
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/round_edit_note_24"
                            />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Editext"
                            android:gravity="center"
                            android:layout_weight="1"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"/>


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/copyText"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    app:cardElevation="8dp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/_8sdp"
                        >
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/round_content_copy_24"
                            app:tint="#000" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Copy"
                            android:gravity="center"
                            android:layout_weight="1"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"/>


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/bgSizeId"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    app:cardElevation="8dp"
                    android:padding="@dimen/_8sdp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        >
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/round_photo_size_select_large_24"
                            />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Size"
                            android:gravity="center"
                            android:layout_weight="1"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"/>


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:id="@+id/sizeTextLayout"
                    app:cardElevation="8dp"
                    >
                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/_8sdp"
                        android:gravity="center"
                        >
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/round_format_size_24"
                            />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Size"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"/>


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/bgFile_get"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    app:cardElevation="8dp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/_8sdp"
                        android:gravity="center"
                        >
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/round_add_photo_alternate_24"
                            />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="BG"
                            android:gravity="center"
                            android:textSize="@dimen/_14ssp"
                            android:textStyle="bold"/>


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_margin="10dp"
                    android:layout_gravity="center"
                    app:cardElevation="8dp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/_8sdp"
                        android:gravity="center"
                        >

                        <Spinner
                            android:id="@+id/spinner"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/btn_dropdown"/>



                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


        </HorizontalScrollView>

    </LinearLayout>

</RelativeLayout>